{
  "name": "elenchi",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "ELENCHI — Adversarial Red-Team Arena & Deterministic Policy Evaluator for AI Trading Agents on Robinhood Chain (4663)",
  "homepage": "https://elenchi.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickCertina/Elenchi.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx apps/api/src/dev-server.ts",
    "build:web": "tsx scripts/build-site.ts",
    "bind:token": "tsx scripts/bind-pons-token.ts",
    "agent:connect": "tsx scripts/connect-agent.ts",
    "agent:webhook": "tsx scripts/example-agent.ts",
    "example:policy": "tsx examples/01-policy-evaluation.ts",
    "example:eip712": "tsx examples/02-eip712-evidence.ts",
    "example:self-connect": "tsx examples/03-self-connect-match.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.evm.test.ts",
    "test:unit": "vitest run tests/policy-evaluator.test.ts tests/eip712.test.ts tests/agent-runner.test.ts tests/token-release.test.ts",
    "test:e2e": "vitest run tests/api.e2e.test.ts tests/custom-fighters.test.ts tests/self-connect-agent.test.ts"
  },
  "dependencies": {
    "viem": "^2.58.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "^22.15.0",
    "solc": "^0.8.28",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3.1.3"
  }
}
